<UserControl x:Class="DentalX.DicomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrBgDeep}">
        <StackPanel Margin="24" MaxWidth="820">
            <TextBlock Text="DICOM Import / Export" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>
            <TextBlock Text="Supports uncompressed grayscale DICOM — the common case for direct sensor output. Compressed transfer syntaxes (JPEG/JPEG2000/RLE) aren't decoded yet and will show a clear error rather than a garbled image."
                       FontSize="12" Foreground="{StaticResource BrTextMuted}" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- IMPORT -->
            <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18" Margin="0,0,0,20"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📥 Import DICOM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,12"/>
                    <Button Content="Choose .dcm File..." Height="32" Width="180" HorizontalAlignment="Left" Cursor="Hand" Click="ImportChoose_Click"
                            Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="12" BorderThickness="0" Margin="0,0,0,14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0A0E14" CornerRadius="8" Height="200">
                            <Image x:Name="imgImportPreview" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <StackPanel x:Name="stackImportTags" Grid.Column="2"/>
                    </Grid>

                    <TextBlock x:Name="txtImportStatus" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,10" Visibility="Collapsed"/>
                    <Button x:Name="btnSaveImported" Content="💾 Save as Capture" Height="32" Width="160" HorizontalAlignment="Left" Cursor="Hand"
                            Click="SaveImported_Click" IsEnabled="False"
                            Background="#059669" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Opacity="{TemplateBinding Opacity}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- EXPORT -->
            <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📤 Export as DICOM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,12"/>
                    <Button Content="Choose Image to Export..." Height="32" Width="200" HorizontalAlignment="Left" Cursor="Hand" Click="ExportChoose_Click"
                            Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="12" BorderThickness="0" Margin="0,0,0,14">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="txtExportSource" Text="No image chosen" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Patient Name" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtExportPatientName" Style="{StaticResource DarkTextBox}" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Patient ID" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtExportPatientId" Style="{StaticResource DarkTextBox}" Height="30"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Modality" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbExportModality" Height="30" FontSize="12" SelectedIndex="0" Margin="0,0,0,14" Width="180" HorizontalAlignment="Left">
                        <ComboBoxItem Content="IO (Intraoral)"/>
                        <ComboBoxItem Content="PX (Panoramic)"/>
                        <ComboBoxItem Content="CR (Computed Radiography)"/>
                        <ComboBoxItem Content="DX (Digital X-Ray)"/>
                    </ComboBox>

                    <Button Content="Export as DICOM (.dcm)..." Height="34" Width="200" HorizontalAlignment="Left" Cursor="Hand" Click="Export_Click"
                            Background="#7C3AED" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="txtExportStatus" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
