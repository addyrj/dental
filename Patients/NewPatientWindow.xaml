<Window x:Class="DentalX.NewPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Patient" Height="700" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid>
        <Border Background="{StaticResource BrBgPanel}" CornerRadius="14" Margin="20"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="＋ New Patient" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>
                    <TextBlock Text="Patient ID: auto-generated on save" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,14"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Title" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbTitle" Height="32" FontSize="12" SelectedIndex="0">
                                    <ComboBoxItem Content="—"/>
                                    <ComboBoxItem Content="Mr"/>
                                    <ComboBoxItem Content="Mrs"/>
                                    <ComboBoxItem Content="Ms"/>
                                    <ComboBoxItem Content="Dr"/>
                                    <ComboBoxItem Content="Master"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="First Name *" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtFirstName" Style="{StaticResource DarkTextBox}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Last Name" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtLastName" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gender" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbGender" Height="32" FontSize="12" SelectedIndex="0">
                                    <ComboBoxItem Content="Not specified"/>
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Age" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtAge" Style="{StaticResource DarkTextBox}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Date of Birth (DD/MM/YYYY)" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDob" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Phone" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Address" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtAddress" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Country" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtCountry" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Notes" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNotes" Style="{StaticResource DarkTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>

                        <TextBlock x:Name="txtError" Foreground="{StaticResource BrDanger}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Height="38" Margin="0,0,4,0"
                            Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextSec}"
                            FontSize="13" BorderThickness="0" Cursor="Hand" Click="btnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="1" Content="Save Patient" Height="38" Margin="4,0,0,0"
                            Background="#7C3AED" Foreground="White"
                            FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="btnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
