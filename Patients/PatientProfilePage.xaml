<UserControl x:Class="DentalX.PatientProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DentalX">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrBgDeep}">
        <StackPanel Margin="24">
            <Button Content="← Back to Patients" HorizontalAlignment="Left" Height="30" Padding="10,0" Margin="0,0,0,14"
                    Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextSec}" FontSize="11"
                    BorderThickness="0" Cursor="Hand" Click="Back_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource BrAccentDim}" Margin="0,0,14,0"
                        Cursor="Hand" MouseLeftButtonDown="Photo_Click" ToolTip="Click to set patient photo" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="txtAvatar" Text="?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="imgPhoto" Stretch="UniformToFill" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderName" Text="Patient" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                    <TextBlock x:Name="txtHeaderSub" Text="ID —" FontSize="12" Foreground="{StaticResource BrTextMuted}"/>
                </StackPanel>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtStatExams" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Examinations" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtStatImages" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Visits" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtStatTreatments" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Treatment Items" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="14"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrTextMuted}"/>
                        <TextBlock Text="Reports (soon)" FontSize="10" Foreground="{StaticResource BrTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: editable details -->
                <Border Grid.Column="0" Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Patient Details" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Title:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTitle" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Name:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtName" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Age:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtAge" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Date of Birth:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtDob" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30" ToolTip="DD/MM/YYYY"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Gender:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtGender" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Phone:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtPhone" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Address:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtAddress" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Country:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCountry" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="30"/></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Notes:" Foreground="{StaticResource BrTextMuted}" FontSize="12" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <TextBox x:Name="txtNotes" Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/></Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="💾 Save Changes" Height="32" Margin="0,0,4,0"
                                    Background="#7C3AED" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0"
                                    Cursor="Hand" Click="Save_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="1" Content="🗑 Delete Patient" Height="32" Margin="4,0,0,0"
                                    Background="#7F1D1D" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold" BorderThickness="0"
                                    Cursor="Hand" Click="Delete_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: examination history -->
                <Border Grid.Column="2" Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Examination History" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="stackExams"/>
                        <TextBlock x:Name="txtNoExams" Text="No examinations on file yet. Attach an image to this patient from the Imaging page."
                                   FontSize="11" Foreground="{StaticResource BrTextMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Treatment Plan -->
            <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18" Margin="0,20,0,0"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Treatment Plan" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="stackTreatments"/>
                    <TextBlock x:Name="txtNoTreatments" Text="No treatment items yet — add one below." FontSize="11"
                               Foreground="{StaticResource BrTextMuted}" Visibility="Collapsed" Margin="0,0,0,10"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtNewTooth" Grid.Column="0" Style="{StaticResource DarkTextBox}" Height="32"
                                 ToolTip="Tooth # (optional)"/>
                        <TextBox x:Name="txtNewTreatment" Grid.Column="2" Style="{StaticResource DarkTextBox}" Height="32"
                                 ToolTip="Treatment description"/>
                        <ComboBox x:Name="cmbNewPriority" Grid.Column="4" Height="32" FontSize="11" SelectedIndex="1">
                            <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/>
                        </ComboBox>
                        <ComboBox x:Name="cmbNewStatus" Grid.Column="6" Height="32" FontSize="11" SelectedIndex="0">
                            <ComboBoxItem Content="Planned"/><ComboBoxItem Content="Recommended"/><ComboBoxItem Content="Completed"/>
                        </ComboBox>
                        <Button Grid.Column="8" Content="+ Add" Height="32" Cursor="Hand" Click="AddTreatment_Click"
                                Background="#7C3AED" Foreground="White" FontSize="11" FontWeight="SemiBold" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="Tooth # (optional)  ·  Treatment description  ·  Priority  ·  Status" FontSize="9"
                               Foreground="{StaticResource BrTextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <local:ToothChartControl x:Name="toothChart"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
