<UserControl x:Class="DentalX.BackupRestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrBgDeep}">
        <StackPanel Margin="24" MaxWidth="620">
            <TextBlock Text="Backup &amp; Restore" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtLastBackup" Text="No backup has been made yet." FontSize="12" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,20"/>

            <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💾 Backup" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,6"/>
                    <TextBlock Text="Saves your patient database and every captured image into one .zip file, wherever you choose."
                               FontSize="12" Foreground="{StaticResource BrTextSec}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Run Backup Now..." Height="34" Width="180" HorizontalAlignment="Left" Cursor="Hand" Click="Backup_Click"
                            Background="#059669" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="♻ Restore" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,6"/>
                    <TextBlock Text="Replaces your CURRENT database and captures with the contents of a backup .zip. This overwrites current data — use with care."
                               FontSize="12" Foreground="{StaticResource BrDanger}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Restore From Backup..." Height="34" Width="180" HorizontalAlignment="Left" Cursor="Hand" Click="Restore_Click"
                            Background="#7F1D1D" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="txtStatus" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
