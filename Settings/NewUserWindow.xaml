<Window x:Class="DentalX.NewUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Staff Account" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid>
        <Border Background="{StaticResource BrBgPanel}" CornerRadius="14" Margin="20"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
            <StackPanel Margin="24">
                <TextBlock Text="＋ Add Staff Account" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,18"/>

                <TextBlock Text="Full Name" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFullName" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Username" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Role" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbRole" Height="32" FontSize="12" SelectedIndex="0" Margin="0,0,0,12">
                    <ComboBoxItem Content="Assistant"/>
                    <ComboBoxItem Content="Dentist"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="pwdPassword" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                             BorderBrush="{StaticResource BrBorder}" BorderThickness="1" Padding="8,5" FontSize="12" Height="32" Margin="0,0,0,12"/>

                <TextBlock Text="Confirm Password" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="pwdConfirm" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                             BorderBrush="{StaticResource BrBorder}" BorderThickness="1" Padding="8,5" FontSize="12" Height="32" Margin="0,0,0,6"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource BrDanger}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Height="38" Margin="0,0,4,0" Cursor="Hand" Click="btnCancel_Click"
                            Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextSec}" FontSize="13" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="1" Content="Create Account" Height="38" Margin="4,0,0,0" Cursor="Hand" Click="btnSave_Click"
                            Background="#7C3AED" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
