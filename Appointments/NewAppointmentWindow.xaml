<Window x:Class="DentalX.NewAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Appointment" Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Border Background="{StaticResource BrBgPanel}" CornerRadius="14" Margin="20"
            BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="＋ New Appointment" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Patient *" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPatientSearch" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,4" TextChanged="txtPatientSearch_TextChanged"/>
                <ListBox x:Name="lstPatients" Height="120" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                         BorderBrush="{StaticResource BrBorder}" BorderThickness="1" FontSize="12" Margin="0,0,0,14"
                         SelectionChanged="lstPatients_SelectionChanged"/>

                <TextBlock x:Name="txtSelectedPatient" Text="No patient selected" FontSize="11" Foreground="{StaticResource BrAccent}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date *" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpDate" Height="32" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Time * (HH:mm)" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTime" Style="{StaticResource DarkTextBox}" Height="32" Text="09:00"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Reason" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtReason" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,6"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource BrDanger}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="38" Margin="0,0,4,0" Cursor="Hand" Click="btnCancel_Click"
                        Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextSec}" FontSize="13" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="1" Content="Save Appointment" Height="38" Margin="4,0,0,0" Cursor="Hand" Click="btnSave_Click"
                        Background="#7C3AED" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
