<UserControl x:Class="DentalX.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="DashboardPage_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BrBgDeep}">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                <Button Content="📷 Imaging" HorizontalAlignment="Right" Height="34" Padding="14,0" Cursor="Hand" Click="GoToImaging_Click"
                        Background="#008000" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,5,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <TextBlock x:Name="txtWelcome" Text="Welcome back" FontSize="13" Foreground="{StaticResource BrTextSec}" Margin="0,0,0,20"/>

            <!-- Stat Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16" Margin="0,0,12,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📷" FontSize="20" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtStatToday" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Today's Captures" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16" Margin="0,0,12,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="20" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtStatPatients" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Total Patients" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16" Margin="0,0,12,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🆕" FontSize="20" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtStatNewPatients" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="New Patients (7d)" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🧠" FontSize="20" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtStatAI" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrTextMuted}"/>
                        <TextBlock Text="AI Findings — model not connected" FontSize="11" Foreground="{StaticResource BrTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Examinations -->
                <Border Grid.Column="0" Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16" Margin="0,0,12,0"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Recent Captures" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="stackRecent"/>
                        <TextBlock x:Name="txtNoRecent" Text="No captures yet — connect the sensor and take your first X-ray from the Imaging page."
                                   FontSize="12" Foreground="{StaticResource BrTextMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Storage + Session -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16" Margin="0,0,0,12"
                            BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtStorageDetail" Text="—" FontSize="12" Foreground="{StaticResource BrTextSec}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="16"
                            BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Signed in as" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrText}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtWhoAmI" Text="—" FontSize="12" Foreground="{StaticResource BrTextSec}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
