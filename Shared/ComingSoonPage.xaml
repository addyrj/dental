<UserControl x:Class="DentalX.ComingSoonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrBgDeep}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <TextBlock x:Name="txtIcon" Text="🚧" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="txtTitle" Text="Coming Soon" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource BrText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="txtMessage" Text="This screen is being built." FontSize="13"
                       Foreground="{StaticResource BrTextSec}" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
