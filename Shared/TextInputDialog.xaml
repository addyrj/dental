<Window x:Class="DentalX.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="220" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Border Background="{StaticResource BrBgPanel}" CornerRadius="12" Margin="16"
            BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock x:Name="txtPrompt" Text="Enter text:" FontSize="13" Foreground="{StaticResource BrText}" Margin="0,0,0,10"/>
            <TextBox x:Name="txtInput" Style="{StaticResource DarkTextBox}" Height="34" KeyDown="txtInput_KeyDown"/>
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="34" Margin="0,0,4,0" Cursor="Hand" Click="Cancel_Click"
                        Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextSec}" FontSize="12" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="1" Content="OK" Height="34" Margin="4,0,0,0" Cursor="Hand" Click="Ok_Click"
                        Background="#7C3AED" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
