<Window x:Class="DentalX.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DentalX — Login" Height="540" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <Grid>
        <Border Background="{StaticResource BrBgPanel}" CornerRadius="14" Margin="28"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" Margin="32">
                <Image Source="logo.png" Height="48" Margin="0,0,0,12" Stretch="Uniform"/>
                <TextBlock Text="DentalX" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Dental X-Ray Imaging System" FontSize="12" Foreground="{StaticResource BrTextSec}"
                           HorizontalAlignment="Center" Margin="0,2,0,26"/>

                <TextBlock Text="Username" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsername" Style="{StaticResource DarkTextBox}" Height="34" Margin="0,0,0,14"
                         KeyDown="Input_KeyDown"/>

                <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <PasswordBox x:Name="txtPassword" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                                 BorderBrush="{StaticResource BrBorder}" BorderThickness="1" Padding="8,5,34,5" FontSize="12"
                                 Height="34" KeyDown="Input_KeyDown"/>
                    <TextBox x:Name="txtPasswordVisible" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                             BorderBrush="{StaticResource BrBorder}" BorderThickness="1" Padding="8,5,34,5" FontSize="12"
                             Height="34" KeyDown="Input_KeyDown" Visibility="Collapsed"/>
                    <Button x:Name="btnTogglePassword" Content="👁" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="30" Height="28" Margin="0,0,2,0" Background="Transparent" Foreground="{StaticResource BrTextMuted}"
                            FontSize="14" BorderThickness="0" Cursor="Hand" Click="btnTogglePassword_Click" ToolTip="Show password">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="txtError" Text="" Foreground="{StaticResource BrDanger}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                <Button x:Name="btnLogin" Content="Login" Height="38" Margin="0,18,0,0"
                        Background="{StaticResource BrAccentDim}" Foreground="{StaticResource BrAccent}"
                        FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="btnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="© 2026 DentalX. All rights reserved." FontSize="10" Foreground="{StaticResource BrTextMuted}"
                           HorizontalAlignment="Center" Margin="0,26,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
