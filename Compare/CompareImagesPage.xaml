<UserControl x:Class="DentalX.CompareImagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrBgDeep}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Image Comparison" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Load two images and compare side by side. Zoom/pan stay in sync while the toggle is on."
                   FontSize="12" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,14"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" x:Name="btnChooseLeft" Content="📂 Choose Left Image..." Height="32" Margin="0,0,0,8"
                        Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="12" BorderThickness="0"
                        Cursor="Hand" Click="ChooseLeft_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Row="1" Background="#0A0E14" CornerRadius="8" ClipToBounds="True" x:Name="borderLeft"
                        MouseWheel="Viewer_MouseWheel" MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
                        MouseLeftButtonUp="Viewer_MouseLeftButtonUp" MouseMove="Viewer_MouseMove" Tag="L">
                    <Grid>
                        <Image x:Name="imgLeft" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="scaleLeft" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="panLeft" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock x:Name="txtLeftPlaceholder" Text="No image loaded" Foreground="{StaticResource BrTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="LEFT" Foreground="White" Opacity="0.35" FontWeight="Bold" FontSize="12"
                                   Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" x:Name="btnChooseRight" Content="📂 Choose Right Image..." Height="32" Margin="0,0,0,8"
                        Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="12" BorderThickness="0"
                        Cursor="Hand" Click="ChooseRight_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Row="1" Background="#0A0E14" CornerRadius="8" ClipToBounds="True" x:Name="borderRight"
                        MouseWheel="Viewer_MouseWheel" MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
                        MouseLeftButtonUp="Viewer_MouseLeftButtonUp" MouseMove="Viewer_MouseMove" Tag="R">
                    <Grid>
                        <Image x:Name="imgRight" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="scaleRight" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="panRight" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock x:Name="txtRightPlaceholder" Text="No image loaded" Foreground="{StaticResource BrTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="RIGHT" Foreground="White" Opacity="0.35" FontWeight="Bold" FontSize="12"
                                   Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
            <CheckBox x:Name="chkSync" Content="Sync zoom &amp; pan" IsChecked="True" Foreground="{StaticResource BrText}"
                      FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="−" Width="30" Height="28" Click="ZoomOut_Click" Margin="0,0,4,0"
                    Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" BorderThickness="0"/>
            <TextBlock x:Name="txtZoom" Text="100%" Foreground="{StaticResource BrText}" FontSize="12" Width="50"
                       TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="+" Width="30" Height="28" Click="ZoomIn_Click" Margin="4,0,10,0"
                    Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" BorderThickness="0"/>
            <Button Content="Reset View" Height="28" Padding="12,0" Click="ResetView_Click"
                    Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="11" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
