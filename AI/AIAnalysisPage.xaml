<UserControl x:Class="DentalX.AIAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrBgDeep}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Analysis" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>

        <Border Grid.Row="1" Background="#3A2A0F" CornerRadius="8" Padding="12,10" Margin="0,4,0,16"
                BorderBrush="{StaticResource BrWarning}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Foreground="{StaticResource BrWarning}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="No detection model is connected. Every value on this screen is a placeholder — nothing here is a real finding."
                           FontSize="12" Foreground="{StaticResource BrWarning}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Image area -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="📂 Choose Image..." Height="32" Margin="0,0,0,8" HorizontalAlignment="Left" Padding="14,0"
                        Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrText}" FontSize="12" BorderThickness="0"
                        Cursor="Hand" Click="ChooseImage_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Row="1" Background="#0A0E14" CornerRadius="8">
                    <Grid>
                        <Image x:Name="imgTarget" Stretch="Uniform" Margin="8"/>
                        <TextBlock x:Name="txtNoImage" Text="Choose an image to (not) analyze" Foreground="{StaticResource BrTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Findings panel -->
            <Border Grid.Column="2" Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="AI Detection: model not connected" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Caries" Foreground="{StaticResource BrTextSec}" FontSize="12" Width="150"/>
                        <TextBlock Text="—" Foreground="{StaticResource BrTextMuted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bone Loss" Foreground="{StaticResource BrTextSec}" FontSize="12" Width="150"/>
                        <TextBlock Text="—" Foreground="{StaticResource BrTextMuted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Periapical Lesion" Foreground="{StaticResource BrTextSec}" FontSize="12" Width="150"/>
                        <TextBlock Text="—" Foreground="{StaticResource BrTextMuted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Calculus" Foreground="{StaticResource BrTextSec}" FontSize="12" Width="150"/>
                        <TextBlock Text="—" Foreground="{StaticResource BrTextMuted}" FontSize="12"/>
                    </StackPanel>

                    <Button Content="Run AI Analysis" Height="34" Background="{StaticResource BrBgCard}" Foreground="{StaticResource BrTextMuted}"
                            FontSize="12" BorderThickness="0" Click="RunAnalysis_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Requires a trained ONNX model + ONNX Runtime — not included yet." FontSize="10"
                               Foreground="{StaticResource BrTextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
