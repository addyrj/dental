<UserControl x:Class="DentalX.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BrBgDeep}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Pick a patient and an examination, then print — choose &quot;Microsoft Print to PDF&quot; in the dialog to save as a PDF file."
                   FontSize="12" Foreground="{StaticResource BrTextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBox x:Name="txtSearch" Style="{StaticResource DarkTextBox}" Height="32" Margin="0,0,0,8" TextChanged="txtSearch_TextChanged"/>
                <ListBox x:Name="lstPatients" Height="520" Background="{StaticResource BrBgPanel}" Foreground="{StaticResource BrText}"
                         BorderBrush="{StaticResource BrBorder}" BorderThickness="1" FontSize="12"
                         SelectionChanged="lstPatients_SelectionChanged"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource BrBgPanel}" CornerRadius="10" Padding="18"
                    BorderBrush="{StaticResource BrBorder}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="txtSelectedPatient" Text="Select a patient on the left" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Examinations" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrTextSec}" Margin="0,0,0,8"/>
                    <ListBox x:Name="lstExams" Height="240" Background="{StaticResource BrBgDark}" Foreground="{StaticResource BrText}"
                             BorderBrush="{StaticResource BrBorder}" BorderThickness="1" FontSize="12" Margin="0,0,0,16"
                             SelectionChanged="lstExams_SelectionChanged"/>

                    <Button Content="🖨 Generate &amp; Print / Save as PDF" Height="36" Cursor="Hand" Click="GenerateAndPrint_Click"
                            Background="#7C3AED" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="txtStatus" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource BrTextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
